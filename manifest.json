{
  "manifest_version": 3,
  "name": "TabNest",
  "version": "1.0.0",
  "description": "Save and restore sessions, manage tabs, and stay organized with a powerful privacy-first session manager.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabNest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "alarms",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
